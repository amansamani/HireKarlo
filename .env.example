# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
AUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
GEMINI_API_KEY=""

# Email (Gmail SMTP + App Password, or compatible SMTP credentials)
EMAIL_USER=""
EMAIL_PASS=""

# Resume storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Calendar integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TOKEN_ENCRYPTION_KEY="generate-a-long-random-secret"

# Vercel Cron authentication
CRON_SECRET="generate-a-long-random-secret"


# Reviewed SaaS configuration additions; existing example values preserved.
AUTH_TRUST_HOST=true
PILOT_SIGNUP_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GEMINI_MODEL=gemini-3.5-flash
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_INR=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_AGENCY_INR=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_AGENCY_USD=
STRIPE_AUTOMATIC_TAX=false
