{
  "name": "HireKarlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "razorpay:setup": "node --experimental-strip-types scripts/setup-razorpay.mjs",
    "razorpay:check": "node --experimental-strip-types scripts/setup-razorpay.mjs --check",
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build --webpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:preflight": "node scripts/database-preflight.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "10.0.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "dotenv": "17.4.2",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/config": "7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "shadcn": "^4.13.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "nodemailer": "$nodemailer",
    "@xmldom/xmldom": "0.8.15",
    "mysql2": "3.24.4",
    "qs": "6.16.0",
    "browserslist": "4.29.0",
    "baseline-browser-mapping": "2.11.24"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
