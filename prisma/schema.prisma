datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enums for rigid workflows
enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  password      String          // Hashed password
  emailVerified DateTime?
  image         String?
  bio           String?
  accounts      Account[]
  sessions      Session[]
  assignedInterviews Interview[] @relation("InterviewerAssignments")
  
  // App-specific tables
  jobs          Job[]
  candidates    Candidate[]
  activityLogs  ActivityLog[]
  memberships   Membership[]
  ownedOrganizations Organization[] @relation("OrganizationOwnership")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessionVersion Int           @default(0)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  ownerId     String
  owner       User @relation("OrganizationOwnership", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  trialEndsAt DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + '14 days'::interval)"))
  subscription Subscription?
  clients     AgencyClient[]
  usageCounters UsageCounter[]
  checkout BillingCheckout?
  razorpayAgreements RazorpayAgreement[]
  billingPayments BillingPayment[]

  googleCalendarEmail String?
  googleRefreshToken  String?

  memberships Membership[]
  invites     TeamInvite[]
  jobs        Job[]
  candidates  Candidate[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       // "OWNER" | "ADMIN" | "RECRUITER" | "INTERVIEWER"
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model TeamInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  token          String       @unique
  expires        DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

model ResumeUpload {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([jobId, expiresAt])
}

model Candidate {
  id             String           @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  experience     Int              // In years
  currentCompany String?
  currentCTC     Float?
  expectedCTC    Float?
  noticePeriod   Int?             // In days
  skills         String[]         // Array of strings supported natively by Postgres
  resumeUrl      String?
  notes          String?
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // recruiterId = creator (kept for attribution/audit trail).
  // organizationId = shared pool scope — this is what dedup and every
  // recruiter-facing query actually filters on, so the whole team sees the
  // same candidate record instead of one copy per person who touched it.
  recruiterId    String
  recruiter      User             @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId, createdAt])
}

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String   // e.g., "Remote", "New York, NY"
  type         String   // e.g., "Full-time", "Part-time", "Contract"
  salaryRange  String?  // e.g., "$100,000 - $130,000"
  description  String   @db.Text
  status       String   @default("OPEN") // OPEN, CLOSED, FILLED
  interviewRounds String[] @default([])
  clientId     String?
  client       AgencyClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  applications JobApplication[]
  resumeUploads ResumeUpload[]

  @@index([userId])
  @@index([organizationId])
}

model JobApplication {
  id                String           @id @default(cuid())
  candidateId       String
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  stage             String           @default("APPLIED")
  appliedDate       DateTime         @default(now())
  assignedRecruiter String?
  remarks           String?

  matchScore        Int?
  aiSummary         String?
  resumeUrl         String?
  privacyAcknowledgedAt DateTime?
  privacyNoticeVersion String?
  
  interviews        Interview[]
  activityLogs      ActivityLog[]
  aiScoringJob      AiScoringJob?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId, createdAt])
}

model Interview {
  id                String    @id @default(cuid())
  applicationId     String
  pipelineStage     String?
  round             String
  interviewer       String
  interviewerId     String?
  googleEventId     String?   // ← the field you added
  scheduledAt       DateTime
  durationMinutes   Int       @default(60)
  meetingLink       String?
  feedback          String?
  result            String?
  rating            Int?
  candidateExperienceRating Int?
  interviewerRating Int?
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  application JobApplication @relation(fields: [applicationId], references: [id])
  interviewerUser User?      @relation("InterviewerAssignments", fields: [interviewerId], references: [id])  // ← ADD THIS LINE
  @@index([applicationId])
  @@index([interviewerId, scheduledAt])
  @@index([scheduledAt, reminderSentAt])
}
model ActivityLog {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  
  action        String          // e.g., "Candidate Created", "Moved to HR"
  details       String?
  
  createdAt     DateTime        @default(now())
  @@index([applicationId, createdAt])
}

model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model ApplicationChallenge {
  email String @id
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model Subscription {
  provider String @default("stripe")
  providerStatus String?
  cancelAtPeriodEnd Boolean @default(false)
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerCustomerId String
  providerSubscriptionId String @unique
  plan String
  status String
  currency String
  currentPeriodEnd DateTime
  updatedAt DateTime @updatedAt
}

model UsageCounter {
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period String
  aiScores Int @default(0)
  @@id([organizationId, period])
}

model BillingCheckout {
  provider String @default("stripe")
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerSessionId String @unique
  url String
  expiresAt DateTime
  plan String?
  currency String?
  idempotencyKey String? @unique
  requestBody String? @db.Text
}

model EmailOutbox {
  id String @id @default(cuid())
  dedupeKey String? @unique
  recipient String
  subject String
  html String @db.Text
  attachments Json?
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  sentAt DateTime?
  failedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  @@index([sentAt, failedAt, availableAt])
}

model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  actorId String
  action String
  targetId String
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

model BillingEvent {
  id String @id
  processedAt DateTime @default(now())
}

model RazorpayAgreement {
  id String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan String
  providerPlanId String
  keyId String
  amount Int
  providerSubscriptionId String? @unique
  creationAttemptedAt DateTime?
  status String @default("creating")
  cancelAtPeriodEnd Boolean @default(false)
  nextSyncAt DateTime @default(now())
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([nextSyncAt])
}

model BillingPayment {
  id String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider String
  providerSubscriptionId String
  providerPaymentId String
  providerInvoiceId String
  amount Int
  currency String
  status String
  refundedAmount Int @default(0)
  paidAt DateTime
  updatedAt DateTime @updatedAt
  @@unique([provider, providerPaymentId])
  @@index([organizationId, paidAt])
}

model AgencyClient {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  contactEmail String?
  notes String? @db.Text
  jobs Job[]
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

model AiScoringJob {
  applicationId String @id
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  completedAt DateTime?
  failedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([completedAt, failedAt, availableAt])
}
